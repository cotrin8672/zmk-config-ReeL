#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

&mt { flavor = "hold-preferred"; tapping-term-ms = <220>; quick-tap-ms = <200>; };
&lt { flavor = "balanced"; tapping-term-ms = <220>; };

// One 20 ms tick per encoder tap, i.e. one wheel unit per detent.
&msc { trigger-period-ms = <20>; };

/ {
    behaviors {
        wheel_up: wheel_up {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&msc MOVE_Y(50)>, <&kp C_VOL_UP>;
            mods = <(MOD_LGUI)>;
            keep-mods = <(MOD_LGUI)>;
        };
        wheel_down: wheel_down {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&msc MOVE_Y(-50)>, <&kp C_VOL_DN>;
            mods = <(MOD_LGUI)>;
            keep-mods = <(MOD_LGUI)>;
        };
        vertical: vertical_wheel {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&wheel_up>, <&wheel_down>;
            tap-ms = <30>;
        };
        horizontal: horizontal_wheel {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc MOVE_X(50)>, <&msc MOVE_X(-50)>;
            tap-ms = <30>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        base {
            bindings = <
                &kp T &kp R &kp E &kp W &kp Q                       &kp P &kp O &kp I &kp U &kp Y
                &kp G &kp F &kp D &kp S &kp A &mt LCTRL ESC         &mt LC(LSHIFT) SEMICOLON &kp L &kp K &kp J &kp H
                &kp B &kp V &kp C &kp X &kp Z &kp LGUI              &kp SLASH &kp DOT &kp COMMA &kp M &kp N
                &mkp MB5 &mkp MB4 &mt LSHIFT LANG2 &lt 1 SPACE &mt LALT LANG1    &kp MINUS &kp TAB &lt 2 ENTER &mt RCTRL BSPC
            >;
            sensor-bindings = <&vertical>;
        };
        numbers {
            bindings = <
                &kp N5 &kp N4 &kp N3 &kp N2 &kp N1                   &kp N0 &kp N9 &kp N8 &kp N7 &kp N6
                &kp LS(COMMA) &kp LS(N9) &kp LS(LBKT) &kp LBKT &kp LS(SQT) &trans   &kp SQT &kp RBKT &kp LS(RBKT) &kp LS(N0) &kp LS(DOT)
                &kp LS(N5) &kp KP_DIVIDE &kp KP_MULTIPLY &kp KP_MINUS &kp KP_PLUS &trans   &kp LS(N6) &trans &trans &kp EQUAL &kp LS(SEMICOLON)
                &trans &trans &trans &trans &trans                    &trans &trans &trans &trans
            >;
            sensor-bindings = <&vertical>;
        };
        navigation {
            bindings = <
                &kp F5 &kp F4 &kp F3 &kp F2 &kp F1                    &kp F10 &kp F9 &kp F8 &kp F7 &kp F6
                &kp LG(LS(T)) &kp LS(BACKSLASH) &kp LS(N7) &kp LS(N1) &kp LS(N6) &trans   &kp LS(N4) &kp RIGHT &kp UP &kp DOWN &kp LEFT
                &trans &kp LS(N3) &kp GRAVE &kp LS(GRAVE) &kp LG(LS(S)) &bt BT_NXT   &kp BACKSLASH &trans &kp LS(N2) &kp EQUAL &trans
                &trans &trans &trans &trans &trans                     &kp F11 &kp F12 &trans &trans
            >;
            sensor-bindings = <&horizontal>;
        };
        mouse {
            bindings = <
                &trans &trans &trans &trans &trans                    &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans             &trans &mkp MB2 &mkp MB3 &mkp MB1 &trans
                &trans &trans &trans &trans &trans &none              &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans                    &trans &trans &trans &trans
            >;
            // No sensor binding: inherit the highest active lower layer.
        };
    };
};
