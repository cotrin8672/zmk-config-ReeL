#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan;
        zmk,matrix-transform = &reel_transform;
    };

    reel_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        rows = <4>;
        columns = <11>;
        // Same matrix order as RMK main, omitting its three unpopulated positions.
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)         RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4)         RC(3,6) RC(3,7) RC(3,8) RC(3,9)
        >;
    };

    encoder: encoder {
        compatible = "alps,ec11";
        a-gpios = <&gpio1 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio1 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <36>; // BM4.0A01: 9 quadrature cycles, 18 clicks.
        status = "disabled";
    };

    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder>;
        triggers-per-rotation = <18>;
    };

    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;
        ball_split: input@0 {
            compatible = "zmk,input-split";
            reg = <0>;
            status = "disabled";
        };
    };
};
