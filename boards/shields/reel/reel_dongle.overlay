#include "reel.dtsi"
#include <input/processors.dtsi>
#include <input/processors/spike_filter.dtsi>
#include <dt-bindings/zmk/input_transform.h>

&ball_split { status = "okay"; };

&zip_temp_layer {
    require-prior-idle-ms = <500>;
    // Zero-based keymap positions: L/K/J (MB2/3/1), then MB5/4.
    excluded-positions = <17 18 19 32 33>;
};

// 1600 sensor CPI * 3/8 = 600 effective CPI, preserving fractional movement.
// Smooth raw deltas before scaling, using the same filter on every layer.
#define REEL_POINTER <&zip_spike_filter 3>, <&zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_Y_INVERT)>, <&zip_xy_scaler 3 8>

/ {
    kscan: kscan {
        compatible = "zmk,kscan-mock";
        rows = <0>;
        columns = <0>;
        events = <0>;
    };

    ball_listener {
        compatible = "zmk,input-listener";
        device = <&ball_split>;
        // Dominant directions of the RMK calibration: (raw Y, -raw X).
        input-processors = REEL_POINTER, <&zip_temp_layer 3 5000>;

        manual_layers {
            layers = <1 2>;
            input-processors = REEL_POINTER;
        };
    };
};
